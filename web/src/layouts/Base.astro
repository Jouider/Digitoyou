---
import Footer from '../components/Footer.astro';
import PageProgress from '../components/PageProgress.astro';
import Head from '../components/Head.astro';
import SiteScripts from '../components/SiteScripts.astro';
import Navbar from '../components/Navbar.astro';
import SharedOffcanvas from '../components/SharedOffcanvas.astro';

import '../styles/global.scss';

const { title = 'Digitoyou' } = Astro.props || {};
---
<!doctype html>
<html lang="fr">
  <Head title={title}>
   

    <slot name="head" />

    <!-- If you keep shipping prebuilt CSS from /public/assets, load non-blocking -->
    <link rel="preload" href="/assets/css/plugins.css" as="style" onload="this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="/assets/css/plugins.css"></noscript>

  </Head>

  <body>
    <!-- Top nav -->
    <header class="wrapper transparent w-100 position-absolute top-0 start-0 z-50">
      <Navbar />
    </header>

    <!-- Shared offcanvas for mobile nav (single instance in the DOM) -->
    <SharedOffcanvas />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- Page progress indicator -->
    <PageProgress />

    <!-- Centralized scripts (ensure Bootstrap *JS* is included in SiteScripts) -->
    <SiteScripts />
    <slot name="scripts" />
    <!-- WhatsApp floating bubble (bottom-left) -->
    <a
      class="whatsapp-float"
      href="https://wa.me/212708156603"
      target="_blank"
      rel="noopener noreferrer"
      data-i18n-aria-label="whatsapp.aria_label"
      aria-label="Contactez-nous sur WhatsApp"
      title="WhatsApp"
      id="whatsapp-float-bubble"
    >
      <!-- Inline WhatsApp SVG (simple white icon) -->
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M20.52 3.48A11.8 11.8 0 0 0 12 .25C5.94.25.99 5.2.99 11.25c0 1.98.52 3.92 1.5 5.64L.01 24l6.34-1.65a11.83 11.83 0 0 0 5.64 1.44h.02c6.06 0 11.01-4.95 11.01-11.01 0-3.01-1.17-5.82-3.2-7.5zM12 21.5h-.01c-1.86 0-3.68-.5-5.24-1.44l-.38-.23-3.76.97.99-3.66-.25-.38A9.25 9.25 0 0 1 2.75 11.25c0-5.04 4.1-9.15 9.15-9.15 2.44 0 4.73.95 6.45 2.67 1.72 1.72 2.66 4.01 2.66 6.45 0 5.05-4.1 9.15-9.15 9.15z"/>
        <path fill="#fff" d="M17.5 14.07c-.29-.14-1.7-.84-1.96-.94-.26-.11-.45-.15-.64.14-.19.29-.74.94-.9 1.14-.16.19-.32.21-.61.07-.29-.14-1.23-.45-2.35-1.45-.87-.78-1.46-1.75-1.63-2.04-.17-.29-.02-.45.13-.59.13-.12.29-.32.43-.48.14-.16.19-.29.29-.48.1-.19.05-.36-.02-.5-.07-.14-.64-1.54-.88-2.11-.23-.55-.47-.48-.64-.49-.16-.01-.36-.01-.55-.01-.19 0-.5.07-.76.36-.26.29-1 1-1 2.45s1.02 2.85 1.16 3.05c.14.19 2 3.05 4.84 4.27 1.35.58 1.9.62 2.58.52.66-.1 2.15-.88 2.46-1.73.31-.86.31-1.6.22-1.75-.08-.15-.29-.24-.58-.38z"/>
      </svg>
      <!-- Tooltip message -->
      <span class="whatsapp-tooltip" data-i18n="whatsapp.tooltip">
        💬 Besoin d'aide ? Parlons maintenant !
      </span>
    </a>

    <style>
      .whatsapp-float {
        position: fixed;
        left: 1rem;
        bottom: 1rem;
        width: 56px;
        height: 56px;
        background: #25D366;
        color: #fff;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 18px rgba(0,0,0,0.12);
        z-index: 9999;
        text-decoration: none;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .whatsapp-float:hover,
      .whatsapp-float:focus {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.18);
        outline: none;
      }
      .whatsapp-float svg { 
        width: 26px; 
        height: 26px; 
        transition: transform 0.3s ease;
      }
      .whatsapp-float:hover svg {
        transform: scale(1.1);
      }
      
      /* Tooltip styling */
      .whatsapp-tooltip {
        position: absolute;
        left: 70px;
        top: 50%;
        transform: translateY(-50%) translateX(-10px);
        background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
        color: #fff;
        padding: 0.75rem 1.25rem;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        white-space: nowrap;
        box-shadow: 0 8px 24px rgba(37, 211, 102, 0.3);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        pointer-events: none;
        z-index: 10000;
      }
      
      /* Arrow tooltip */
      .whatsapp-tooltip::before {
        content: '';
        position: absolute;
        left: -8px;
        top: 50%;
        transform: translateY(-50%);
        width: 0;
        height: 0;
        border-top: 8px solid transparent;
        border-bottom: 8px solid transparent;
        border-right: 8px solid #25D366;
      }
      
      .whatsapp-float:hover .whatsapp-tooltip,
      .whatsapp-float:focus .whatsapp-tooltip {
        opacity: 1;
        visibility: visible;
        transform: translateY(-50%) translateX(0);
      }
      
      /* Pulse animation subtile */
      @keyframes pulse-ring {
        0% {
          transform: scale(0.95);
          box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7);
        }
        70% {
          transform: scale(1);
          box-shadow: 0 0 0 15px rgba(37, 211, 102, 0);
        }
        100% {
          transform: scale(0.95);
          box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
        }
      }
      
      .whatsapp-float {
        animation: pulse-ring 2s infinite;
      }
      
      /* Responsive adjustments */
      @media (max-width: 768px) {
        .whatsapp-tooltip {
          font-size: 0.85rem;
          padding: 0.6rem 1rem;
        }
        .whatsapp-float {
          width: 50px;
          height: 50px;
        }
        .whatsapp-float svg {
          width: 24px;
          height: 24px;
        }
      }
    </style>
  </body>
</html>
