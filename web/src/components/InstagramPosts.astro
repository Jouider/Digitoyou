---
// Instagram Feed Component using Elfsight
---

<section class="wrapper bg-light" id="instagram-section">
  <div class="container pt-14">
    <!-- Section Title -->
    <div class="row">
      <div class="col-lg-9 col-xl-8 col-xxl-7 mx-auto text-center mb-10">
        <h2 class="fs-15 text-uppercase text-primary mb-3" data-i18n="index.instagram.subtitle">Suivez-nous</h2>
        <h3 class="display-4 mb-4" data-i18n="index.instagram.title">Nos dernières actualités Instagram</h3>
        <p class="lead mb-0" data-i18n="index.instagram.description">Découvrez nos projets, conseils et inspirations digitales</p>
      </div>
    </div>
    
    <!-- Elfsight Instagram Feed -->
    <div class="row">
      <div class="col-12">
        <div class="elfsight-app-2629ee21-1417-4f37-bd07-21d9cea25637" data-elfsight-app-lazy></div>
      </div>
    </div>

    <!-- CTA to Instagram Profile -->
  </div>
</section>

<!-- Elfsight Instagram Feed Script -->
<script src="https://elfsightcdn.com/platform.js" async></script>

<style>
  /* Ensure Elfsight widget is responsive */
  #instagram-section .elfsight-app-2629ee21-1417-4f37-bd07-21d9cea25637 {
    width: 100%;
  }
  
  /* Hide Elfsight branding badge and free widget text */
  #instagram-section .elfsight-app-2629ee21-1417-4f37-bd07-21d9cea25637 [class*="eapps-link"],
  #instagram-section .elfsight-app-2629ee21-1417-4f37-bd07-21d9cea25637 [class*="eapps-branding"],
  #instagram-section .elfsight-app-2629ee21-1417-4f37-bd07-21d9cea25637 a[href*="elfsight"],
  #instagram-section .elfsight-app-2629ee21-1417-4f37-bd07-21d9cea25637 [class*="eapps-instagram-feed-title"],
  #instagram-section .elfsight-app-2629ee21-1417-4f37-bd07-21d9cea25637 div[class*="header"],
  #instagram-section div[class*="eapps-instagram-feed-header"] {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    height: 0 !important;
    overflow: hidden !important;
  }
  
  /* Additional fallback to hide any text containing "Free" */
  #instagram-section .elfsight-app-2629ee21-1417-4f37-bd07-21d9cea25637 *:has-text("Free"),
  #instagram-section .elfsight-app-2629ee21-1417-4f37-bd07-21d9cea25637 *:contains("Free") {
    display: none !important;
  }
</style>
