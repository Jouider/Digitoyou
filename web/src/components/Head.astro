---
const { title = 'Digitoyou - Sites web sur-mesure & performants' } = Astro.props || {};
---
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> 

  <!-- SEO: Meta Info -->
  <title>{title}</title>
  <meta name="description" content="Digitoyou crée des sites web puissants, 100% personnalisés, conçus pour convertir. Livraison rapide, support réactif, zéro frais cachés.">
  <meta name="keywords" content="digitoyou, création site web, site vitrine, site e-commerce, agence web, développement web, UX design, SEO, landing page, site personnalisé, freelance, startup, PME">
  <meta name="author" content="Digitoyou" />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph (réseaux sociaux) -->
  <meta property="og:title" content="Digitoyou - Sites web performants et sur-mesure">
  <meta property="og:description" content="Sites modernes, optimisés pour la conversion. Maintenance offerte, support rapide et expérience utilisateur fluide.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.digitoyou.com">
  <meta property="og:image" content="https://www.digitoyou.com/assets/img/og-image.jpg">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Digitoyou - Sites web sur-mesure">
  <meta name="twitter:description" content="Des sites pensés pour convertir. Sur-mesure, rapide et sans surprise.">
  <meta name="twitter:image" content="https://www.digitoyou.com/assets/img/og-image.jpg">

  <!-- Favicon -->
  <link rel="icon" href="/assets/img/favicon.png" type="image/png">

  <!-- CDN fallback for core framework (Bootstrap) so dev server works without Gulp-built assets -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Swiper CSS -->
  <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
  <link rel="preconnect" href="/" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Font CSS + primary WOFF2 preloads -->
  <link rel="preload" href="/assets/fonts/thicccboi/thicccboi.css" as="style" onload="this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/assets/fonts/thicccboi/thicccboi.css"></noscript>
  <link rel="preload" as="font" href="/assets/fonts/thicccboi/THICCCBOI-Regular.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/assets/fonts/thicccboi/THICCCBOI-Bold.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/assets/fonts/thicccboi/THICCCBOI-Medium.woff2" type="font/woff2" crossorigin>


  <!-- Preload LCP hero image (with responsive hints) -->
  <link
    rel="preload"
    as="image"
    href="/assets/img/pages/hero-1200.webp"
    imagesrcset="/assets/img/pages/hero-800.webp 800w, /assets/img/pages/hero-1200.webp 1200w, /assets/img/pages/hero-1600.webp 1600w"
    imagesizes="(max-width: 600px) 100vw, 1200px"
  >
  <!-- Critical above-the-fold CSS: keep tiny to avoid blocking render but reserve space for hero, header and basic typography -->
  <style>
    /* Minimal critical CSS to prevent CLS and ensure LCP-friendly paint */
    :root{--navbar-height:72px}
    html,body{height:100%;}
    /* Reserve header space to avoid layout shift on sticky header */
    /* .navbar, header.wrapper {min-height:var(--navbar-height);height:var(--navbar-height)} */
    /* Ensure first hero section has reserved height to avoid LCP shifting */
    .wrapper.position-relative:first-of-type, .hero, .site-hero {min-height:60vh}
    /* Basic typography scaling for above-the-fold */
    .display-1{font-size:clamp(28px,5vw,48px);line-height:1.05;margin:0}
    .lead{font-size:clamp(14px,2.2vw,20px);margin:0}
    /* Prevent media reflow for logos/thumbnails */
    img,svg,video{max-width:100%;height:auto;display:block}
    .logo-light,.logo-dark{width:140px;height:auto}
  </style>



  <!-- Allow pages to inject additional head tags via slot -->
  <slot />

</head>
