---
---
<footer class="bg-dark text-inverse">
  <div class="container py-13 py-md-15">
    <div class="row gy-6 gy-lg-0">
      <div class="col-md-4 col-lg-3">
        <div class="widget">
          <img class="mb-4" src="/assets/img/logo-light.svg" alt="Digitoyou" />
          <p class="mb-4 small" data-i18n="footer.copyright">Digitoyou © 2025. Tous droits réservés.</p>
          <nav class="nav social">
            <a href="#"><i class="uil uil-instagram text-primary"></i></a>
            <a href="#"><i class="uil uil-linkedin text-primary"></i></a>
          </nav>
        </div>
      </div>

      <div class="col-md-4 col-lg-3">
      <h4 class="widget-title mb-3 text-light" data-i18n="footer.contact.title">Contact</h4>
        <div class="widget contact-widget">
          <a href="mailto:hello@digitoyou.com" class="btn btn-primary btn-sm rounded-pill mb-2" data-i18n="footer.contact.email">hello@digitoyou.com</a>
          <a href="#" class="btn btn-primary btn-sm rounded-pill" data-i18n="footer.contact.phone">+1 866 306 4636</a>
        </div>
      </div>

      <div class="col-md-4 col-lg-3">
        <div class="widget">
          <h4 class="widget-title mb-3 text-light" data-i18n="footer.resources.title">Ressources</h4>
          <ul class="list-unstyled mb-0">
            <li><a href="#" data-i18n="footer.resources.blog">Blog</a></li>
            <li><a href="#" data-i18n="footer.resources.legal">Mentions légales</a></li>
          </ul>
        </div>
      </div>

      <div class="col-md-12 col-lg-3">
        <div class="widget">
          <h4 class="widget-title mb-3 text-light" data-i18n="footer.discover.title">Découvrir</h4>
          <ul class="list-unstyled mb-0">
            <li><a href="#" data-i18n="footer.discover.about">À propos de nous</a></li>
            <li><a href="#" data-i18n="footer.discover.services">Nos services</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>