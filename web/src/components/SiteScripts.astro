---
/* SiteScripts.astro — global scripts loaded once in Base */
---
<!-- External libraries (load once) -->
<script src="/assets/js/plugins.js" defer></script>
<script src="/assets/js/i18n.js" defer></script>
<!-- We do our own SVG injection below, svg-inject.min.js not needed -->
<script src="/assets/js/theme.js" defer></script>
<script src="https://unpkg.com/swiper/swiper-bundle.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/tsparticles@2/tsparticles.bundle.min.js" defer></script>

<style>
  /* Keep overlay clickable through the color layer */
  figure.overlay span.bg { pointer-events: none; }
</style>

<!-- Accessibility helpers: sync aria-expanded on offcanvas toggles, add missing labels -->
<script>
  document.addEventListener('DOMContentLoaded', function(){
    // Keep hamburger aria-expanded in sync with offcanvas
    document.querySelectorAll('.hamburger-visual.offcanvas-nav-btn, .hamburger.offcanvas-nav-btn')
      .forEach(function(btn){
        if (!(btn instanceof HTMLElement)) return;
        if (!btn.hasAttribute('aria-expanded')) btn.setAttribute('aria-expanded', 'false');
        var target = btn.getAttribute('data-bs-target') || btn.getAttribute('data-target');
        if (target) {
          var off = document.querySelector(target);
          if (off) {
            off.addEventListener('show.bs.offcanvas', function(){ btn.setAttribute('aria-expanded', 'true'); });
            off.addEventListener('hide.bs.offcanvas', function(){ btn.setAttribute('aria-expanded', 'false'); });
          }
        }
        // Fallback toggle
        btn.addEventListener('click', function(){
          var state = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', state ? 'false' : 'true');
        });
      });

    // Add aria-label to trash/remove links in cart if missing
    document.querySelectorAll('a > i.uil-trash-alt').forEach(function(icon){
      var a = icon.closest('a');
      if (a && !a.hasAttribute('aria-label')) a.setAttribute('aria-label','Remove item from cart');
    });

    // Add aria-label to icon-only social links
    document.querySelectorAll('.nav.social a, nav.social a').forEach(function(a){
      if (!a.getAttribute('aria-label')) {
        var icon = a.querySelector('i');
        if (icon) {
          var cls = (icon.className || '').split(' ').find(function(c){ return c.indexOf('uil-') === 0; });
          var label = cls ? cls.replace('uil-','').replace(/-/g,' ') : 'Social link';
          a.setAttribute('aria-label', label.charAt(0).toUpperCase() + label.slice(1));
        }
      }
    });
  });
</script>

<!-- Inline SVG injector: replace <img class="svg-inject"> with inline <svg> and let CSS style it -->
<script>
  document.addEventListener('DOMContentLoaded', async function(){
    var imgs = document.querySelectorAll('img.svg-inject');
    for (var img of imgs) {
      if (!(img instanceof HTMLImageElement)) continue;
      try {
        var src = img.src || img.getAttribute('src') || '';
        var res = await fetch(src, { cache: 'force-cache' });
        if (!res.ok) continue;
        var svgText = await res.text();
        var wrap = document.createElement('div');
        wrap.innerHTML = svgText.trim();
        var svg = wrap.querySelector('svg');
        if (!svg) continue;

        // carry over classes (minus the marker)
        var cls = (img.getAttribute('class') || '')
          .split(' ').filter(function(c){ return c && c !== 'svg-inject'; }).join(' ');
        if (cls) svg.setAttribute('class', cls);

        // Remove hard fills/strokes so theme classes can color
        svg.querySelectorAll('[fill]').forEach(function(el){
          var val = el.getAttribute('fill');
          if (val && val !== 'none') {
            el.classList.add('lineal-fill');
            el.removeAttribute('fill');
          }
        });
        svg.querySelectorAll('[stroke]').forEach(function(el){
          var val = el.getAttribute('stroke');
          if (val && val !== 'none') {
            el.classList.add('lineal-stroke');
            el.removeAttribute('stroke');
          }
        });

        // fallback sizes if missing
        if (!svg.getAttribute('width'))  svg.setAttribute('width',  img.getAttribute('width')  || '48');
        if (!svg.getAttribute('height')) svg.setAttribute('height', img.getAttribute('height') || '48');

        img.replaceWith(svg);
      } catch (e) {
        console.warn('SVG inject failed for', img.src, e);
        try { img.style.visibility = 'visible'; } catch (er) {}
      }
    }
  });
</script>

<!-- Contact page: project carousel + modal (runs only if #projectCarousel exists) -->
<script>
  (function () {
    var carouselRoot = document.getElementById('projectCarousel');
    if (!(carouselRoot instanceof HTMLElement)) return; // Only on pages that have the carousel
    var carousel = carouselRoot;

    // Arrow handlers (used by inline onclick)
    window.scrollProjects = function (direction) {
      var container = document.getElementById('projectCarousel');
      if (!(container instanceof HTMLElement)) return;
      container.scrollBy({ left: direction * 320, behavior: 'smooth' });
    };

    function bootstrapReady(){
      var b = window['bootstrap'];
      return !!(b && b.Modal);
    }

    var projects = [];
    var modalSwiper = null;

    function makeCard(p) {
      var title = (p.title && (p.title.fr || p.title.en)) || p.id || '';
      var desc  = (typeof p.description === 'string')
                    ? p.description
                    : (p.description && (p.description.fr || p.description.en)) || '';
      var img   = (p.images && p.images[0]) || '';

      var fig = document.createElement('figure');
      fig.className = 'overlay overlay-2 hover-scale color rounded me-3';
      fig.style.minWidth = '360px';

      fig.innerHTML = '\
        <a href="#" class="js-open-project" data-project-id="'+ (p.id || '') +'">\
          ' + (img
            ? '<img src="'+ img +'" alt="'+ (title||'').replace(/"/g,"") +'" loading="lazy">'
            : '<div class="no-image-placeholder" style="width:100%;height:120px;background:#f5f5f5;border-radius:6px;"></div>'
          ) + '\
        </a>\
        <span class="bg"></span>\
        <figcaption>\
          <h5 class="from-top mb-1">'+ title +'</h5>\
          <p class="from-bottom small mb-0">'+ (desc ? desc.slice(0,90) : '') +'</p>\
        </figcaption>';
      return fig;
    }

    function openProjectModal(projectId){
      var raw = projects.find(function(x){ return x && x.id === projectId; });
      if (!raw) return;

      var modalEl = document.getElementById('projectModal');
      if (!(modalEl instanceof HTMLElement)) return;

      var titleEl = document.getElementById('modalProjectTitle');
      var descEl  = document.getElementById('modalProjectDescription');
      var techEl  = document.getElementById('modalTechStack');
      var linkEl  = document.getElementById('modalProjectLink');
      var slides  = document.getElementById('modalImageCarousel');
      if (!(titleEl && descEl && techEl && slides)) return;

      var title = (raw.title && (raw.title.fr || raw.title.en)) || raw.id || '';
      var desc  = (typeof raw.description === 'string')
                    ? raw.description
                    : (raw.description && (raw.description.fr || raw.description.en)) || '';

      titleEl.textContent = title;
      descEl.textContent  = desc || '';

      techEl.innerHTML = '';
      (raw.tech || []).forEach(function(t){
        var tag = document.createElement('span');
        tag.className = 'badge bg-primary-subtle text-primary fw-semibold px-2 py-1 rounded-pill';
        tag.textContent = t;
        techEl.appendChild(tag);
      });

      if (linkEl instanceof HTMLAnchorElement) {
        try { linkEl.href = raw.link || '#'; }catch(e){}
        linkEl.style.display = raw.link ? 'inline-block' : 'none';
      }

      // Media
      slides.innerHTML = '';
      var hasVideo = raw.video && raw.video.src;
      if (hasVideo) {
        var slide = document.createElement('div');
        slide.className = 'swiper-slide';
        slide.innerHTML =
          '<video class="w-100 h-100 object-fit-cover rounded" autoplay muted loop playsinline webkit-playsinline preload="none" poster="'+ (raw.poster || '') +'" disablepictureinpicture controlslist="nodownload noplaybackrate nofullscreen" style="pointer-events:none;">\
             <source src="'+ (raw.video.src) +'" type="'+ (raw.video.type || 'video/webm') +'">\
           </video>';
        slides.appendChild(slide);
        if (modalSwiper) { try{ modalSwiper.destroy(true,true); }catch(e){} modalSwiper = null; }
      } else {
        (raw.images || []).forEach(function(src){
          var slide = document.createElement('div');
          slide.className = 'swiper-slide';
          slide.innerHTML = '<img src="'+ src +'" alt="'+ title +'" class="img-fluid w-100 h-100 object-fit-cover" loading="lazy">';
          slides.appendChild(slide);
        });

        var init = function(){
          var SwiperCtor = window['Swiper'];
          if (!SwiperCtor) { setTimeout(init, 50); return; }
          var slideCount = slides.querySelectorAll('.swiper-slide').length;
          var allowLoop = slideCount > 1;
          if (modalSwiper) { try { modalSwiper.update(); } catch(e){} }
          else {
            modalSwiper = new SwiperCtor('.project-modal-swiper', {
              loop: allowLoop,
              navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
              pagination: { el: '.swiper-pagination', clickable: true }
            });
          }
        };
        init();
      }

      if (bootstrapReady()) {
        window['bootstrap'].Modal.getOrCreateInstance(modalEl).show();
      } else {
        console.warn('Bootstrap JS not found. Include bootstrap.bundle.min.js.');
      }
    }

    // Delegate clicks from the carousel to open the modal
    carousel.addEventListener('click', function(e){
      if (!(e.target instanceof Element)) return;
      var a = e.target.closest('a.js-open-project');
      if (!a) return;
      e.preventDefault();
      e.stopPropagation();
      var id = a.getAttribute('data-project-id');
      if (id) openProjectModal(id);
    });

    // Load projects
    async function loadProjects(){
      try{
        var res = await fetch('/assets/js/projects2.json', { cache: 'no-store' });
        if(!res.ok) throw new Error('Failed to load projects2.json');
        var json = await res.json();
        projects = (json.projects || []).sort(function(a,b){ return (a.order||0)-(b.order||0); });

        carousel.innerHTML = '';
        if (!projects.length) {
          carousel.innerHTML = '<div class="d-flex align-items-center justify-content-center text-muted py-5 w-100" style="min-width:360px;">No projects</div>';
          return;
        }
        projects.forEach(function(p){ carousel.appendChild(makeCard(p)); });
      } catch(e){
        console.error(e);
        var loading = document.getElementById('projectCarouselLoading');
        if (loading) loading.textContent = 'Failed to load projects';
      }
    }

    document.addEventListener('DOMContentLoaded', loadProjects);
  })();
</script>

<!-- Index page: testimonials/projects swiper + typing effect (runs only if #projects-swiper OR .text-typing exist) -->
<script>
  window.addEventListener('load', function(){
    // Guard: only on index-like pages
    if (!document.getElementById('projects-swiper') && !document.querySelector('.text-typing')) return;

    function onIdle(cb){
      if('requestIdleCallback' in window) requestIdleCallback(cb,{timeout:1500});
      else setTimeout(cb,300);
    }

    // Dynamic Projects Loader then Swiper init
    var projectsSwiperEl = document.getElementById('projects-swiper');
    var projectsWrapper = document.getElementById('projects-swiper-wrapper');
    var dataSource = projectsSwiperEl ? projectsSwiperEl.getAttribute('data-source') : null;

    function buildSlide(p){
      var slide = document.createElement('div');
      slide.className = 'swiper-slide testimonial-slide';
      slide.innerHTML =
        '<div class="testimonial-card d-flex flex-column">\
          <div class="testimonial-img mb-3">\
            <video class="img-fluid rounded" autoplay muted loop playsinline preload="none" poster="'+ (p.poster || '') +'">\
              <source src="'+ ((p.video && p.video.src) || '') +'" type="'+ ((p.video && p.video.type) || 'video/webm') +'">\
              '+ (p.video && p.video.label || p.name || '') + '\
            </video>\
          </div>\
          <h5 class="testimonial-title" data-i18n="'+ (p.i18nTitle || '') +'">'+ (p.title || '') +'</h5>\
          <p class="text-muted flex-grow-1" data-i18n-html="'+ (p.i18nDesc || '') +'">'+ (p.desc || '') +'</p>\
          <a href="'+ (p.link || '#') +'" target="_blank" rel="noopener" class="fw-bold mt-auto" data-i18n="'+ (p.i18nCta || '') +'">Visit Website &gt;</a>\
        </div>';
      return slide;
    }

    async function loadProjects(){
      if(!dataSource || !projectsWrapper) return;
      try{
        var res = await fetch(dataSource, { cache: 'no-store' });
        if(!res.ok) throw new Error('Failed to load projects');
        var data = await res.json();
        projectsWrapper.innerHTML = '';
        (data.sort ? data.sort(function(a,b){ return (a.order||0)-(b.order||0); }) : data)
          .forEach(function(p){ projectsWrapper.appendChild(buildSlide(p)); });
        if (window['applyI18n']) { window['applyI18n'](); }
      }catch(err){
        console.error(err);
        projectsWrapper.innerHTML = '<div class="text-danger p-4">Failed to load projects.</div>';
      }finally{
        initProjectsSwiper();
      }
    }

    function initProjectsSwiper(){
      if(!projectsSwiperEl) return;
      if(projectsSwiperEl.dataset.initialized) return; // guard
      onIdle(function(){
        try{
          var SwiperCtor = window['Swiper'];
          if (!SwiperCtor) return;
          new SwiperCtor('.mySwiper', {
            slidesPerView: 'auto',
            spaceBetween: 30,
            speed: 3000,
            freeMode: true,
            freeModeMomentum: false,
            autoplay: { delay: 0, disableOnInteraction: false },
            breakpoints: { 320:{slidesPerView:1.2}, 768:{slidesPerView:2.2}, 1200:{slidesPerView:3.5} }
          });
        }catch(e){
          console.warn('Projects swiper init failed', e);
        }
      });
      projectsSwiperEl.dataset.initialized = 'true';
    }

    // Load testimonials/projects and init swiper
    loadProjects();

    // Typing effect
    (function(){
      var el = document.querySelector('.text-typing');
      if(!el) return;
      var words = window['i18nTypingWords'] || ['Simplement','Rapidement','Facilement'];
      var wordIndex = 0, letterIndex = 0, typingForward = true, timerId = null;

      function resetTyping(newWords){
        words = (newWords && newWords.length) ? newWords : words;
        el.textContent = words[0] || '';
        wordIndex = 0; letterIndex = 0; typingForward = true;
      }

      function animateTyping(){
        var currentWord = words[wordIndex] || '';
        if(typingForward){
          letterIndex++;
          if(letterIndex > currentWord.length){
            typingForward = false;
            timerId = setTimeout(animateTyping, 1000);
            return;
          }
        } else {
          letterIndex--;
          if(letterIndex === 0){
            typingForward = true;
            wordIndex = (wordIndex + 1) % words.length;
          }
        }
        el.textContent = currentWord.slice(0, letterIndex);
        timerId = setTimeout(animateTyping, typingForward ? 150 : 50);
      }

      resetTyping(window['i18nTypingWords']);
      animateTyping();

      document.addEventListener('i18n:updated', function(){
        if(window['i18nTypingWords'] && window['i18nTypingWords'].length){
          clearTimeout(timerId);
          resetTyping(window['i18nTypingWords']);
          animateTyping();
        }
      });
    })();
  });
</script>

<!-- Global: initialize all .brand-swiper instances once -->
<script>
  function initBrandSwipers(){
    var SwiperCtor = window['Swiper'];
    if (!SwiperCtor) return;
    document.querySelectorAll('.brand-swiper').forEach(function(el){
      if (!(el instanceof HTMLElement)) return;
      if (el.dataset.initialized === 'true') return;
      var slideCount = el.querySelectorAll('.swiper-slide').length || 0;
      var perView = 2;
      var loop = slideCount > perView;
      try {
        new SwiperCtor(el, {
          slidesPerView: perView,
          spaceBetween: 30,
          loop: loop,
          speed: 3000,
          autoplay: { delay: 0, disableOnInteraction: false },
          breakpoints: { 768:{slidesPerView:3}, 992:{slidesPerView:4}, 1200:{slidesPerView:5} }
        });
        el.dataset.initialized = 'true';
      } catch(e) {
        console.warn('Brand swiper init failed', e);
      }
    });
  }

  window.addEventListener('load', function(){
    if ('requestIdleCallback' in window) requestIdleCallback(initBrandSwipers, { timeout: 1500 });
    else setTimeout(initBrandSwipers, 300);
  });
</script>
