<section class="wrapper bg-soft-primary " data-cue="fadeIn">
    <div class="container py-14 py-md-16">
      <div class="row gx-lg-8 gy-8 align-items-center">
        <!-- Images right -->
        <div class="col-lg-6 order-lg-2">
          <div class="row gx-md-5 gy-5">
            <div class="col-md-6 align-self-end">
              <figure class="rounded"><img loading="lazy" src="/assets/img/photos/g1.jpg" srcset="/assets/img/photos/g1@2x.jpg 2x" alt=""></figure>
            </div>
            <div class="col-md-6 align-self-start d-none d-lg-block">
              <figure class="rounded"><img loading="lazy" src="/assets/img/photos/g2.jpg" srcset="/assets/img/photos/g2@2x.jpg 2x" alt=""></figure>
            </div>
          </div>
        </div>
        <!-- Content left -->
        <div class="col-lg-6">
          <h2 class="display-4 mb-3" data-i18n="index.delivery.title">Livraison garantie, ou services offerts</h2>
          <p class="lead fs-lg mb-8 pe-xxl-2" data-i18n-html="index.delivery.lead"> Chez Digitoyou, on respecte les délais.<br> Sinon ? Vous recevez <strong>2 mois gratuits</strong> de chaque service ci-dessous : </p>
          <div class="row gx-xl-10 gy-6">
            <div class="col-md-6 col-lg-12 col-xl-6 text-center text-md-start">
              <div class="d-flex flex-column align-items-center align-items-md-start">
                <div class="icon btn btn-circle btn-lg btn-soft-primary pe-none mb-3">
                  <i class="uil uil-wrench"></i>
                </div>
                <h4 class="mb-1" data-i18n="index.delivery.benefit1">2 mois de maintenance</h4>
              </div>
            </div>
            <div class="col-md-6 col-lg-12 col-xl-6 text-center text-md-start">
              <div class="d-flex flex-column align-items-center align-items-md-start">
                <div class="icon btn btn-circle btn-lg btn-soft-primary pe-none mb-3">
                  <i class="uil uil-server"></i>
                </div>
                <h4 class="mb-1" data-i18n="index.delivery.benefit2">2 mois d’hébergement</h4>
              </div>
            </div>
            <div class="col-md-6 col-lg-12 col-xl-6 text-center text-md-start">
              <div class="d-flex flex-column align-items-center align-items-md-start">
                <div class="icon btn btn-circle btn-lg btn-soft-primary pe-none mb-3">
                  <i class="uil uil-document-layout-left"></i>
                </div>
                <h4 class="mb-1" data-i18n="index.delivery.benefit4">2 mois d’articles de blog</h4>
              </div>
            </div>
            <div class="col-md-6 col-lg-12 col-xl-6 text-center text-md-start">
              <div class="d-flex flex-column align-items-center align-items-md-start">
                <div class="icon btn btn-circle btn-lg btn-soft-primary pe-none mb-3">
                  <i class="uil uil-instagram"></i>
                </div>
                <h4 class="mb-1" data-i18n="index.delivery.benefit3">2 mois de social media</h4>
              </div>
            </div>
