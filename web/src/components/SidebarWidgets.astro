---
---
<!-- Recherche -->
<div class="widget">
  <form class="search-form">
    <div class="form-floating mb-0">
      <input id="search-form" type="text" class="form-control" data-i18n-placeholder="index.blog.sidebar.search_placeholder" placeholder="">
      <label for="search-form" data-i18n="index.blog.sidebar.search_placeholder"></label>
    </div>
  </form>
</div>
<!-- /.widget -->

<!-- À propos -->
<div class="widget">
  <h4 class="widget-title mb-3" data-i18n="index.blog.sidebar.about_title"></h4>
  <p data-i18n-html="index.blog.sidebar.about_html"></p>
  <nav class="nav social">
    <a href="#"><i class="uil uil-twitter"></i></a>
    <a href="#"><i class="uil uil-facebook-f"></i></a>
    <a href="#"><i class="uil uil-instagram"></i></a>
    <a href="#"><i class="uil uil-linkedin"></i></a>
    <a href="#"><i class="uil uil-youtube"></i></a>
  </nav>
</div>
<!-- /.widget -->

<!-- Articles populaires -->
<div class="widget">
  <h4 class="widget-title mb-3" data-i18n="index.blog.sidebar.popular_title"></h4>
  <ul class="image-list">
    <li>
      <figure class="rounded">
        <a href="/blog-post">
          <img src="/assets/img/photos/b4.jpg" alt="SEO artisans" />
        </a>
      </figure>
      <div class="post-content">
        <h6 class="mb-2">
          <a class="link-dark" href="/blog-post" data-i18n="index.blog.post.posts.grid1.title"></a>
        </h6>
        <ul class="post-meta">
          <li class="post-date"><i class="uil uil-calendar-alt"></i><span data-i18n="index.blog.post.posts.grid1.date"></span></li>
          <li class="post-comments"><a href="#"><i class="uil uil-comment"></i><span class="comments-count">4</span> <span data-i18n="index.blog.post.meta.comments"></span></a></li>
        </ul>
      </div>
    </li>
    <li>
      <figure class="rounded">
        <a href="/blog-post">
          <img src="/assets/img/photos/b5.jpg" alt="Etude de cas e-commerce" />
        </a>
      </figure>
      <div class="post-content">
        <h6 class="mb-2">
          <a class="link-dark" href="/blog-post" data-i18n="index.blog.post.posts.p2.title"></a>
        </h6>
        <ul class="post-meta">
          <li class="post-date"><i class="uil uil-calendar-alt"></i><span data-i18n="index.blog.post.posts.p2.date"></span></li>
          <li class="post-comments"><a href="#"><i class="uil uil-comment"></i><span class="comments-count">5</span> <span data-i18n="index.blog.post.meta.comments"></span></a></li>
        </ul>
      </div>
    </li>
    <li>
      <figure class="rounded">
        <a href="/blog-post">
          <img src="/assets/img/photos/b6.jpg" alt="Réservation en ligne" />
        </a>
      </figure>
      <div class="post-content">
        <h6 class="mb-2">
          <a class="link-dark" href="/blog-post" data-i18n="index.blog.post.posts.p3.title"></a>
        </h6>
        <ul class="post-meta">
          <li class="post-date"><i class="uil uil-calendar-alt"></i><span data-i18n="index.blog.post.posts.p3.date"></span></li>
          <li class="post-comments"><a href="#"><i class="uil uil-comment"></i><span class="comments-count">8</span> <span data-i18n="index.blog.post.meta.comments"></span></a></li>
        </ul>
      </div>
    </li>
  </ul>
</div>
<!-- /.widget -->

<!-- Catégories -->
<div class="widget">
  <h4 class="widget-title mb-3" data-i18n="index.blog.sidebar.categories_title"></h4>
  <ul class="unordered-list bullet-primary text-reset">
    <li><a href="#"><span data-i18n="index.blog.post.categories.digitalization"></span> (12)</a></li>
    <li><a href="#"><span data-i18n="index.blog.post.categories.websites"></span> (8)</a></li>
    <li><a href="#"><span data-i18n="index.blog.post.categories.case_studies"></span> (5)</a></li>
    <li><a href="#"><span data-i18n="index.blog.post.categories.tutorials"></span> (7)</a></li>
    <li><a href="#"><span data-i18n="index.blog.post.categories.seo"></span> (4)</a></li>
    <li><a href="#"><span data-i18n="index.blog.post.categories.artisans"></span> (6)</a></li>
  </ul>
</div>
<!-- /.widget -->

