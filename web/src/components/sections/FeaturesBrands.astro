---
/**
 * Value & Impact Section
 * Displays business outcomes and value propositions with premium card design
 */
import BrandMarquee from '../BrandMarquee.astro';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

const valueCards = [
  { 
    titleKey: 'index.value.card1_title',
    textKey: 'index.value.card1_text',
    impactKey: 'index.value.card1_impact'
  },
  { 
    titleKey: 'index.value.card2_title',
    textKey: 'index.value.card2_text',
    impactKey: 'index.value.card2_impact'
  },
  { 
    titleKey: 'index.value.card3_title',
    textKey: 'index.value.card3_text',
    impactKey: 'index.value.card3_impact'
  },
  { 
    titleKey: 'index.value.card4_title',
    textKey: 'index.value.card4_text',
    impactKey: 'index.value.card4_impact'
  }
];
---

<Section variant="light">
  <Container class="py-14 py-md-17">
    <!-- Section Header -->
    <div class="row text-center mb-10 mb-md-12">
      <div class="col-lg-9 col-xl-8 col-xxl-7 mx-auto">
        <h2 class="display-5 mb-4" data-i18n="index.value.title">
          Des résultats concrets pour votre activité
        </h2>
        <p class="lead text-muted mb-0" data-i18n="index.value.subtitle">
          Un site web pensé pour attirer, convaincre et faire grandir votre business.
        </p>
      </div>
    </div>

    <!-- Value Cards Grid -->
    <div class="row g-6 g-lg-8 mb-14 mb-md-16">
      <div class="col-xl-11 col-xxl-10 mx-auto">
        <div class="row g-6 g-lg-8">
          {valueCards.map((card, index) => (
            <div class="col-md-6">
              <div class="value-card">
                <h3 class="value-card-title" data-i18n={card.titleKey}></h3>
                <p class="value-card-text" data-i18n={card.textKey}></p>
                <div class="value-card-impact" data-i18n={card.impactKey}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Brand Marquee with Label -->
    <div class="row">
      <div class="col-12 text-center mb-5">
        <p class="text-uppercase fw-medium fs-14 text-muted mb-0 letter-spacing-1" data-i18n="index.value.brands_title">
          Ils nous font confiance
        </p>
      </div>
      <BrandMarquee />
    </div>
  </Container>
</Section>

<style>
  /* ===== VALUE CARDS ===== */
  
  .value-card {
    background: rgba(248, 250, 252, 0.6);
    border: 1px solid rgba(30, 78, 216, 0.08);
    border-radius: 20px;
    padding: 2.5rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  /* Subtle top gradient accent */
  .value-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, 
      rgba(30, 78, 216, 0.4) 0%, 
      rgba(185, 226, 125, 0.4) 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .value-card:hover {
    background: white;
    border-color: rgba(30, 78, 216, 0.12);
    box-shadow: 0 12px 32px rgba(30, 78, 216, 0.06);
    transform: translateY(-4px);
  }

  .value-card:hover::before {
    opacity: 1;
  }

  /* Card Title */
  .value-card-title {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-text-dark);
    line-height: 1.3;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  /* Card Text */
  .value-card-text {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  /* Impact Metric */
  .value-card-impact {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-primary-blue);
    padding-top: 1rem;
    border-top: 1px solid rgba(30, 78, 216, 0.08);
    letter-spacing: -0.01em;
  }

  /* Typography utilities */
  .fs-14 {
    font-size: 0.875rem;
  }

  .letter-spacing-1 {
    letter-spacing: 0.5px;
  }

  /* ===== RESPONSIVE ADJUSTMENTS ===== */

  /* Tablet (768px - 1023px) */
  @media (min-width: 768px) and (max-width: 1023px) {
    .value-card {
      padding: 2rem 1.75rem;
    }

    .value-card-title {
      font-size: 1.25rem;
    }

    .value-card-text {
      font-size: 0.9375rem;
    }

    .value-card-impact {
      font-size: 1rem;
    }
  }

  /* Mobile (< 768px) */
  @media (max-width: 767px) {
    .value-card {
      padding: 2rem 1.5rem;
      border-radius: 18px;
    }

    .value-card-title {
      font-size: 1.25rem;
      margin-bottom: 0.875rem;
    }

    .value-card-text {
      font-size: 0.9375rem;
      line-height: 1.6;
      margin-bottom: 1.25rem;
    }

    .value-card-impact {
      font-size: 0.9375rem;
      padding-top: 0.875rem;
    }
  }

  /* Small mobile (< 375px) */
  @media (max-width: 374px) {
    .value-card {
      padding: 1.75rem 1.25rem;
    }

    .value-card-title {
      font-size: 1.125rem;
    }
  }

  /* ===== BRAND MARQUEE ENHANCEMENTS ===== */

  :global(.brand-marquee img),
  :global(.swiper-slide img) {
    opacity: 0.45;
    filter: grayscale(100%);
    transition: all 0.3s ease;
  }

  :global(.brand-marquee img:hover),
  :global(.swiper-slide:hover img) {
    opacity: 1;
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  /* ===== ACCESSIBILITY ===== */

  @media (prefers-reduced-motion: reduce) {
    .value-card,
    .value-card::before,
    :global(.brand-marquee img),
    :global(.swiper-slide img) {
      transition: none !important;
    }

    .value-card:hover {
      transform: none !important;
    }

    :global(.swiper-slide:hover img) {
      transform: none !important;
    }
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    .value-card {
      border-width: 2px;
      background: white;
    }

    .value-card-impact {
      border-top-width: 2px;
    }
  }

  /* Focus states for keyboard navigation */
  .value-card:focus-within {
    outline: 2px solid var(--color-primary-blue);
    outline-offset: 4px;
  }
</style>
