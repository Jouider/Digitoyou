---
/**
 * Offers Section
 * Displays service offerings in cards
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';

const offers = [
  {
    icon: '/assets/img/icons/lineal/browser.svg',
    titleKey: 'index.offer_cards.landing_title',
    title: 'Landing Page',
    descKey: 'index.offer_cards.landing_desc',
    desc: 'Une page unique, rapide et ciblée pour transformer vos visiteurs en clients dès leur première visite.',
    ctaKey: 'index.offer_cards.landing_cta',
    cta: 'Parlez à un expert'
  },
  {
    icon: '/assets/img/icons/lineal/watercolor.svg',
    titleKey: 'index.offer_cards.redesign_title',
    title: 'Refonte de Site',
    descKey: 'index.offer_cards.redesign_desc',
    desc: 'Modernisez votre site avec un nouveau design, de meilleures performances et un impact renforcé.',
    ctaKey: 'index.offer_cards.redesign_cta',
    cta: 'Planifier mon rendez-vous'
  },
  {
    icon: '/assets/img/icons/lineal/smartphone.svg',
    titleKey: 'index.offer_cards.showcase_title',
    title: 'Site Vitrine',
    descKey: 'index.offer_cards.showcase_desc',
    desc: 'Présentez votre activité avec élégance. Design responsive, structure claire, résultats concrets.',
    ctaKey: 'index.offer_cards.showcase_cta',
    cta: 'Commencez votre projet'
  },
  {
    icon: '/assets/img/icons/lineal/shop-3.svg',
    titleKey: 'index.offer_cards.ecommerce_title',
    title: 'Site E-Commerce',
    descKey: 'index.offer_cards.ecommerce_desc',
    desc: 'Vendez vos produits en ligne avec une boutique performante, facile à gérer et optimisée pour convertir.',
    ctaKey: 'index.offer_cards.ecommerce_cta',
    cta: 'Je veux être contacté'
  }
];
---

<Section variant="dark">
  <Container class="py-14 py-md-16 text-center">
    <div class="row">
      <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2">
        <h2 class="fs-15 text-uppercase text-muted mb-3 text-white" data-i18n="index.offers.small">Nos Offres</h2>
        <h3 class="display-4 mb-10 px-xl-10 text-white" data-i18n="index.offers.title">Des solutions digitales taillées pour faire décoller votre activité.</h3>
      </div>
    </div>
    
    <div class="position-relative">
      <div class="shape rounded-circle bg-soft-blue rellax w-16 h-16" data-rellax-speed="1" style="bottom: -0.5rem; right: -2.2rem; z-index: 0;"></div>
      <div class="shape bg-dot yellow rellax w-16 h-17" data-rellax-speed="1" style="top: -0.5rem; left: -2.5rem; z-index: 0;"></div>
      
      <div class="row gx-md-5 gy-5 text-center position-relative" style="z-index:1;">
        {offers.map((offer) => (
          <div class="col-md-6 col-xl-3">
            <Card>
              <img loading="lazy" src={offer.icon} class="svg-inject icon-svg icon-svg-md text-yellow mb-3" alt="" />
              <h4 data-i18n={offer.titleKey}>{offer.title}</h4>
              <p class="mb-2" data-i18n-html={offer.descKey}>{offer.desc}</p>
              <a href="/appointment" class="btn btn-primary btn-sm rounded-pill">
                <span data-i18n={offer.ctaKey}>{offer.cta}</span>
              </a>
            </Card>
          </div>
        ))}
      </div>
    </div>
  </Container>
</Section>
