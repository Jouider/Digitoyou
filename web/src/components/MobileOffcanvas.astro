---
export interface Props {
  ctaText?: string;
  ctaHref?: string;
  contactEmail?: string;
  contactPhone?: string;
  socialInstagram?: string;
  socialFacebook?: string;
  socialLinkedIn?: string;
  socialWhatsApp?: string;
}
const {
  ctaText = 'Prendre RDV',
  ctaHref = '/appointment',
  contactEmail = 'hello@digitoyou.com',
  contactPhone = '+212 662-160763',
  socialInstagram = '#',
  socialFacebook = 'https://www.facebook.com/profile.php?id=61581394745108',
  socialLinkedIn = 'https://www.linkedin.com/company/digitoyou/',
  socialWhatsApp = '#',
} = Astro.props as Props;

const OFFCANVAS_ID = 'siteOffcanvas';
const OFFCANVAS_LABEL = 'siteOffcanvasLabel';
---
<div class="offcanvas offcanvas-start"
     id={OFFCANVAS_ID}
     tabindex="-1"
     aria-labelledby={OFFCANVAS_LABEL}>
  <div class="offcanvas-header d-lg-none">
    <img src="/assets/img/logo-light.svg" alt="Logo" width="160" />
    <h5 class="offcanvas-title visually-hidden" id={OFFCANVAS_LABEL}>Menu</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <div class="offcanvas-body ms-lg-auto d-flex flex-column h-100 align-items-center align-items-lg-start text-center text-lg-start">
    <!-- Primary menu -->
    <ul class="navbar-nav">
      <li class="nav-item"><a class="nav-link" href="/about" data-i18n-href="links.about"><span data-i18n="nav.about">A&nbsp;propos</span></a></li>
      <li class="nav-item"><a class="nav-link" href="/blog" data-i18n-href="links.blog"><span data-i18n="nav.blog">Blog</span></a></li>
      <li class="nav-item"><a class="nav-link" href="/contact" data-i18n-href="links.case_client"><span data-i18n="nav.case_client">Cas&nbsp;Client</span></a></li>
    </ul>

    <!-- Mobile-only CTA -->
    <div class="mt-4 d-lg-none w-100">
      <a href={ctaHref} class="btn btn-primary rounded-pill w-100 btn-icon btn-icon-start">
        <i class="uil uil-schedule me-1"></i>
        <span data-i18n-html="index.cta.button">{ctaText}</span>
      </a>
    </div>

    <!-- Footer (mobile) -->
    <div class="offcanvas-footer d-lg-none text-center mt-auto">
      <div>
        <a href={`mailto:${contactEmail}`} class="link-inverse">{contactEmail}</a><br />
        {contactPhone}<br />
        <nav class="nav social social-white mt-4">
          <a href={socialInstagram} aria-label="Instagram"><i class="uil uil-instagram"></i></a>
          <a href={socialFacebook} aria-label="Facebook"><i class="uil uil-facebook-f"></i></a>
          <a href={socialLinkedIn} aria-label="LinkedIn"><i class="uil uil-linkedin"></i></a>
          <a href={socialWhatsApp} aria-label="WhatsApp"><i class="uil uil-whatsapp"></i></a>
        </nav>
      </div>
    </div>
  </div>
</div>

