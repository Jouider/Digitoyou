---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import FeaturesBrands from '../components/sections/FeaturesBrands.astro';
import Projects from '../components/sections/Projects.astro';
import Offers from '../components/sections/Offers.astro';
import DeliverySec from '../components/DeliverySec.astro';
import InstagramPosts from '../components/InstagramPosts.astro';
import FAQ from '../components/FAQ.astro';
---

<Base title="Digitoyou - Accueil">
  <Fragment slot="head">
    <!-- Swiper CSS (page-scoped, non-blocking) -->
    <link
      rel="preload"
      as="style"
      href="https://unpkg.com/swiper@12.0.2/swiper-bundle.min.css"
      onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
      <link rel="stylesheet" href="https://unpkg.com/swiper@12.0.2/swiper-bundle.min.css">
    </noscript>
  </Fragment>

  <!-- Hero Section -->
  <Hero />

  <!-- Features + Brands Section -->
  <FeaturesBrands />

  <!-- Projects / Realizations Section -->
  <Projects />

  <!-- Offers Section -->
  <Offers />

  <!-- Delivery Section -->
  <DeliverySec />

  <!-- Instagram Posts Section -->
  <InstagramPosts />

  <!-- FAQ Section -->
  <FAQ />
</Base>