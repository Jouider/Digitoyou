---
import Base from '../layouts/Base.astro';
---
<Base title="Article - Digitoyou">

  <section class="wrapper bg-soft-primary">
    <div class="container pt-10 pb-19 pt-md-14 pb-md-20 text-center">
      <div class="row">
        <div class="col-md-10 col-xl-8 mx-auto">
          <div class="post-header mt-14">
            <div class="post-category text-line">
              <a href="#" class="hover" rel="category" data-i18n="index.blog.post.categories.digitalization"></a>
              <a href="#" class="hover" rel="category" data-i18n="index.blog.post.categories.entrepreneurship"></a>
            </div>
            <h1 class="display-1 mb-4" data-i18n="index.blog.post.single.title">Titre de l'article</h1>
            <ul class="post-meta mb-5">
              <li class="post-date"><i class="uil uil-calendar-alt"></i><span>4 Août 2025</span></li>
              <li class="post-author"><a href="#"><i class="uil uil-user"></i><span><span data-i18n="index.blog.post.meta.by"></span> <span data-i18n="index.blog.post.meta.author"></span></span></a></li>
              <li class="post-comments"><a href="#"><i class="uil uil-comment"></i><span class="comments-count">0</span> <span data-i18n="index.blog.post.meta.comments"></span></a></li>
              <li class="post-likes"><a href="#"><i class="uil uil-heart-alt"></i><span class="likes-count">0</span> <span data-i18n="index.blog.post.meta.likes"></span></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrapper bg-light">
    <div class="container pb-14 pb-md-16">
      <div class="row">
        <div class="col-lg-10 mx-auto">
          <div class="blog single mt-n17">
            <div class="card">
              <figure class="card-img-top"><img src="/assets/img/photos/b1.jpg" alt="" width="1200" height="675" fetchpriority="high" decoding="async" style="aspect-ratio:16/9;object-fit:cover;"/></figure>
              <div class="card-body">
                <div class="classic-view">
                  <article class="post">
                    <div class="post-content mb-5" data-i18n-html="index.blog.post.single.body_html">Contenu de l'article...</div>
                  </article>

                  <div class="post-footer d-md-flex flex-md-row justify-content-md-between align-items-center mt-8">
                    <div>
                      <ul class="list-unstyled tag-list mb-0">
                        <li><a href="#" class="btn btn-soft-ash btn-sm rounded-pill mb-0" data-i18n="index.blog.post.tags.coder"></a></li>
                        <li><a href="#" class="btn btn-soft-ash btn-sm rounded-pill mb-0" data-i18n="index.blog.post.tags.digitaliser"></a></li>
                        <li><a href="#" class="btn btn-soft-ash btn-sm rounded-pill mb-0" data-i18n="index.blog.post.tags.online"></a></li>
                      </ul>
                    </div>
                    <div class="mb-0 mb-md-2">
                      <div class="dropdown share-dropdown btn-group">
                        <button class="btn btn-sm btn-red rounded-pill btn-icon btn-icon-start dropdown-toggle mb-0 me-0" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="uil uil-share-alt"></i> Share</button>
                        <div class="dropdown-menu"><a class="dropdown-item" href="#"><i class="uil uil-twitter"></i>Twitter</a><a class="dropdown-item" href="#"><i class="uil uil-facebook-f"></i>Facebook</a><a class="dropdown-item" href="#"><i class="uil uil-linkedin"></i>Linkedin</a></div>
                      </div>
                    </div>
                  </div>

                  <hr />

                  <h3 class="mb-6" data-i18n="index.blog.post.single.more_title">Plus d'articles</h3>
                  <div class="swiper-container blog grid-view mb-16" data-margin="30" data-dots="true" data-items-md="2" data-items-xs="1">
                    <div class="swiper">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide">
                                <article>
                                    <figure class="overlay overlay-1 hover-scale rounded mb-5"><a href="#"> <img src="/assets/img/photos/b4.jpg" alt="" loading="lazy" decoding="async" width="800" height="450" style="aspect-ratio:16/9;object-fit:cover;"/></a>
                                        <figcaption>
                                            <h5 class="from-top mb-0" data-i18n="index.blog.post.read_more"></h5>
                                        </figcaption>
                                    </figure>
                                    <div class="post-header">
                                        <div class="post-category text-line">
                                            <a href="#" class="hover" rel="category" data-i18n="index.blog.post.categories.coding"></a>
                                        </div>
                                        <!-- /.post-category -->
                                        <h2 class="post-title h3 mt-1 mb-3"><a class="link-dark" href="/blog-post" data-i18n="index.blog.post.posts.grid1.title"></a></h2>
                                    </div>
                                    <!-- /.post-header -->
                                    <div class="post-footer">
                                        <ul class="post-meta mb-0">
                                            <li class="post-date"><i class="uil uil-calendar-alt"></i><span data-i18n="index.blog.post.posts.grid1.date"></span></li>
                                            <li class="post-comments"><a href="#"><i class="uil uil-comment"></i><span class="comments-count">4</span> <span data-i18n="index.blog.post.meta.comments"></span></a></li>
                                        </ul>
                                    </div>
                                    <!-- /.post-footer -->
                                </article>
                                <!-- /article -->
                            </div>
                            <!--/.swiper-slide -->
                            <div class="swiper-slide">
                                <article>
                                    <figure class="overlay overlay-1 hover-scale rounded mb-5"><a href="#"> <img src="/assets/img/photos/b5.jpg" alt="" loading="lazy" decoding="async" width="800" height="450" style="aspect-ratio:16/9;object-fit:cover;"/></a>
                                        <figcaption>
                                            <h5 class="from-top mb-0" data-i18n="index.blog.post.read_more"></h5>
                                        </figcaption>
                                    </figure>
                                    <div class="post-header">
                                        <div class="post-category text-line">
                                            <a href="#" class="hover" rel="category" data-i18n="index.blog.post.categories.workspace"></a>
                                        </div>
                                        <!-- /.post-category -->
                                        <h2 class="post-title h3 mt-1 mb-3"><a class="link-dark" href="/blog-post" data-i18n="index.blog.post.posts.grid2.title"></a></h2>
                                    </div>
                                    <!-- /.post-header -->
                                    <div class="post-footer">
                                        <ul class="post-meta mb-0">
                                            <li class="post-date"><i class="uil uil-calendar-alt"></i><span data-i18n="index.blog.post.posts.grid2.date"></span></li>
                                            <li class="post-comments"><a href="#"><i class="uil uil-comment"></i><span class="comments-count">3</span> <span data-i18n="index.blog.post.meta.comments"></span></a></li>
                                        </ul>
                                    </div>
                                    <!-- /.post-footer -->
                                </article>
                                <!-- /article -->
                            </div>
                            <!--/.swiper-slide -->
                            <div class="swiper-slide">
                                <article>
                                    <figure class="overlay overlay-1 hover-scale rounded mb-5"><a href="#"> <img src="/assets/img/photos/b6.jpg" alt="" loading="lazy" decoding="async" width="800" height="450" style="aspect-ratio:16/9;object-fit:cover;"/></a>
                                        <figcaption>
                                            <h5 class="from-top mb-0" data-i18n="index.blog.post.read_more"></h5>
                                        </figcaption>
                                    </figure>
                                    <div class="post-header">
                                        <div class="post-category text-line">
                                            <a href="#" class="hover" rel="category" data-i18n="index.blog.post.categories.meeting"></a>
                                        </div>
                                        <!-- /.post-category -->
                                        <h2 class="post-title h3 mt-1 mb-3"><a class="link-dark" href="/blog-post" data-i18n="index.blog.post.posts.grid3.title"></a></h2>
                                    </div>
                                    <!-- /.post-header -->
                                    <div class="post-footer">
                                        <ul class="post-meta mb-0">
                                            <li class="post-date"><i class="uil uil-calendar-alt"></i><span data-i18n="index.blog.post.posts.grid3.date"></span></li>
                                            <li class="post-comments"><a href="#"><i class="uil uil-comment"></i><span class="comments-count">6</span> <span data-i18n="index.blog.post.meta.comments"></span></a></li>
                                        </ul>
                                    </div>
                                    <!-- /.post-footer -->
                                </article>
                                <!-- /article -->
                            </div>
                            <!--/.swiper-slide -->
                            <div class="swiper-slide">
                                <article>
                                    <figure class="overlay overlay-1 hover-scale rounded mb-5"><a href="#"> <img src="/assets/img/photos/b7.jpg" alt="" loading="lazy" decoding="async" width="800" height="450" style="aspect-ratio:16/9;object-fit:cover;"/></a>
                                        <figcaption>
                                            <h5 class="from-top mb-0" data-i18n="index.blog.post.read_more"></h5>
                                        </figcaption>
                                    </figure>
                                    <div class="post-header">
                                        <div class="post-category text-line">
                                            <a href="#" class="hover" rel="category" data-i18n="index.blog.post.categories.business_tips"></a>
                                        </div>
                                        <!-- /.post-category -->
                                        <h2 class="post-title h3 mt-1 mb-3"><a class="link-dark" href="/blog-post" data-i18n="index.blog.post.posts.grid4.title"></a></h2>
                                    </div>
                                    <div class="post-footer">
                                        <ul class="post-meta mb-0">
                                            <li class="post-date"><i class="uil uil-calendar-alt"></i><span data-i18n="index.blog.post.posts.grid4.date"></span></li>
                                            <li class="post-comments"><a href="#"><i class="uil uil-comment"></i><span class="comments-count">2</span> <span data-i18n="index.blog.post.meta.comments"></span></a></li>
                                        </ul>
                                    </div>
                                    <!-- /.post-footer -->
                                </article>
                                <!-- /article -->
                            </div>
                            <!--/.swiper-slide -->
                        </div>
                        <!--/.swiper-wrapper -->
                    </div>
                    <!-- /.swiper -->
                </div>

                  <hr />
                  <h3 class="mb-3" data-i18n="index.blog.post.comment_form.title">Laisser un commentaire</h3>
                  <p class="mb-7" data-i18n="index.blog.post.comment_form.description">Votre avis nous intéresse.</p>
                  <form class="comment-form">
                    <div class="form-floating mb-4"><input type="text" class="form-control" placeholder="Name*" id="c-name" data-i18n-placeholder="index.blog.post.comment_form.name_placeholder"><label for="c-name" data-i18n="index.blog.post.comment_form.name_label"></label></div>
                    <div class="form-floating mb-4"><input type="email" class="form-control" placeholder="Email*" id="c-email" data-i18n-placeholder="index.blog.post.comment_form.email_placeholder"><label for="c-email" data-i18n="index.blog.post.comment_form.email_label"></label></div>
                    <div class="form-floating mb-4"><input type="text" class="form-control" placeholder="Website" id="c-web" data-i18n-placeholder="index.blog.post.comment_form.website_placeholder"><label for="c-web" data-i18n="index.blog.post.comment_form.website_label"></label></div>
                    <div class="form-floating mb-4"><textarea name="textarea" class="form-control" placeholder="Comment" style="height:150px" data-i18n-placeholder="index.blog.post.comment_form.comment_placeholder"></textarea><label data-i18n="index.blog.post.comment_form.comment_label"></label></div>
                    <button type="submit" class="btn btn-primary rounded-pill mb-0" data-i18n="index.blog.post.comment_form.submit_button">Envoyer</button>
                  </form>

                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>