---
import AboutSec from '../components/AboutSec.astro';
import FAQ from '../components/FAQ.astro';
import Base from '../layouts/Base.astro';
---
<Base title="Prendre RDV - Digitoyou">
  <!-- HERO (same wrapper/spacing style as other pages) -->
  <section class="wrapper position-relative overflow-hidden" style="background-color:#edf2fa;" data-image-src="/assets/img/photos/bg23.png">
    <div class="container pt-5 pb-3 text-center">
      <div class="row mt-17">
        <div class="col-lg-10 col-xl-9 mx-auto" data-cues="slideInDown" data-group="page-title">
          <h1 class="display-1 fs-50 " data-i18n-html="index.appointment.hero.h1"></h1>
        </div>
        <div class="container py-8 py-md-10">
            <div class="row gx-lg-6 gy-6 align-items-start justify-content-center">
              <!-- Left: Profile card -->
              <div class="col-lg-4 col-xl-4">
                <div class="card shadow-lg h-100">
                  <div class="card-body p-4">
                    <div class="text-center">
                      <div class="avatar avatar-lg mb-3">
                        <img src="/assets/img/avatars/brahim.jpg" alt="Brahim" class="rounded-circle" />
                      </div>
                      <p class="text-primary mb-2 fs-15 fw-bold">Brahim Berouini</p>
                      <h4 class="mb-2" data-i18n="index.appointment.booking.profile.talk_title">Parlons de votre projet 🚀</h4>
                      <p class="lead mb-1 fs-lg">15 min</p>
                      <p class="text-primary mb-3" data-i18n="index.appointment.booking.profile.free">Consultation gratuite</p>
                      <div class="alert alert-soft-primary">
                        <i class="uil uil-gift me-2" style="font-size:30px;"></i>
                        <p data-i18n="index.appointment.booking.profile.free">Bonus : maquettes UX sous 72h</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
      
              <!-- Dynamic Right Column (Calendar/Form) -->
              <div class="col-lg-7 col-xl-6">
                  <div class="card shadow-lg">
                    <div class="card-body p-3">
                      <div class="steps-indicator mb-2">
                        <div class="d-flex justify-content-between">
                          <span class="step small" id="step1" data-i18n="index.appointment.booking.steps.step1">1. Choisir un créneau</span>
                          <span class="step small" id="step2" data-i18n="index.appointment.booking.steps.step2">2. Vos coordonnées</span>
                        </div>
                        <div class="progress mt-2" style="height: 3px;">
                          <div class="progress-bar" role="progressbar" style="width: 50%" id="stepProgress"></div>
                        </div>
                      </div>
                      <!-- Step 1: Calendar View -->
                      <div id="calendarStep">
                        <div class="calendar-wrapper" id="appointmentCalendar">
                          <!-- Calendar will be inserted here by JavaScript -->
                        </div>
                        <div class="time-slots mt-3" id="timeSlots">
                          <h5 class="mb-2" data-i18n="index.appointment.booking.calendar.slots_title">Créneaux disponibles</h5>
                          <div class="d-flex flex-wrap gap-2" id="timeSlotsGrid">
                            <!-- Time slots will be dynamically populated -->
                          </div>
                        </div>
                        <button class="btn btn-primary rounded-pill w-100 mt-3" id="nextToContactInfo" style="display: none;" data-i18n="index.appointment.booking.calendar.continue">
                          <i class="uil uil-arrow-right me-2"></i>Continuer </button>
                      </div>
                      <!-- Step 2: Contact Form -->
                      <div id="contactStep" style="display: none;">
                        <!-- Add a smaller return button next to 'Vos informations' -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                          <h4 class="mb-0" data-i18n="index.appointment.booking.contact.title">Vos informations</h4>
                          <button class="btn btn-sm btn-outline-primary rounded-pill" id="backToCalendar" data-i18n="index.appointment.booking.contact.back">
                            <i class="uil uil-arrow-left me-2"></i>Retour </button>
                        </div>
                        <form id="appointmentForm" class="booking-form">
                          <input type="hidden" id="appointment_date">
                          <input type="hidden" id="appointment_time">
                          <div class="row">
                            <div class="col-md-6">
                              <div class="form-floating mb-3">
                                <input type="text" class="form-control" placeholder="Votre nom" id="name" required data-i18n-placeholder="index.appointment.booking.contact.name_placeholder">
                                <label for="name" data-i18n="index.appointment.booking.contact.name_label">Nom complet</label>
                              </div>
                            </div>
                            <div class="col-md-6">
                              <div class="form-floating mb-3">
                                <input type="email" class="form-control" placeholder="Votre email" id="email" required data-i18n-placeholder="index.appointment.booking.contact.email_placeholder">
                                <label for="email" data-i18n="index.appointment.booking.contact.email_label">Email</label>
                              </div>
                            </div>
                          </div>
                          <div class="form-floating mb-3">
                            <input type="tel" class="form-control" placeholder="Votre téléphone" id="phoneNumber" required data-i18n-placeholder="index.appointment.booking.contact.phone_placeholder">
                            <label for="phoneNumber" data-i18n="index.appointment.booking.contact.phone_label">Numéro de téléphone</label>
                          </div>
                          <!-- Communication preference - Icons in one line -->
                          <div class="mb-4">
                            <label class="form-label" data-i18n="index.appointment.booking.contact.communication_label">Comment souhaitez-vous échanger ?</label>
                            <div class="communication-icons d-flex justify-content-center gap-4 mt-3">
                              <div class="form-check-icon text-center">
                                <input class="form-check-input d-none" type="radio" name="communication" id="phone" value="phone" checked>
                                <label class="icon-option" for="phone">
                                  <i class="uil uil-phone fs-3"></i>
                                </label>
                                <div class="icon-label mt-2" data-i18n="index.appointment.booking.contact.comm_phone">Téléphone</div>
                              </div>
                              <div class="form-check-icon text-center">
                                <input class="form-check-input d-none" type="radio" name="communication" id="whatsapp" value="whatsapp">
                                <label class="icon-option" for="whatsapp">
                                  <i class="uil uil-whatsapp fs-3"></i>
                                </label>
                                <div class="icon-label mt-2" data-i18n="index.appointment.booking.contact.comm_whatsapp">WhatsApp</div>
                              </div>
                              <div class="form-check-icon text-center">
                                <input class="form-check-input d-none" type="radio" name="communication" id="meet" value="meet">
                                <label class="icon-option" for="meet">
                                  <i class="uil uil-video fs-3"></i>
                                </label>
                                <div class="icon-label mt-2" data-i18n="index.appointment.booking.contact.comm_meet">Google Meet</div>
                              </div>
                            </div>
                          </div>
                          <div class="form-floating mb-3">
                            <textarea class="form-control" placeholder="Votre message" id="message" style="height: 80px" data-i18n-placeholder="index.appointment.booking.contact.message_placeholder"></textarea>
                            <label for="message" data-i18n="index.appointment.booking.contact.message_label">Que puis-je faire pour vous ? (optionnel)</label>
                          </div>
                          <div class="selected-slot mb-3" id="selectedSlotDisplay">
                            <div class="alert alert-primary d-none py-2" role="alert">
                              <small> <span data-i18n="index.appointment.booking.contact.slot_label">Créneau :</span>
                                <span id="selectedDateTime" data-i18n="index.appointment.booking.contact.none">Aucun</span></small>
                            </div>
                          </div>
                          <button class="btn btn-primary rounded-pill w-100" type="submit" id="submitButton" data-i18n="index.appointment.booking.contact.submit">
                            <i class="uil uil-check me-2"></i>Confirmer le rendez-vous </button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- Success Message Modal -->
                <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-body text-center p-6">
                        <i class="uil uil-check-circle text-primary" style="font-size: 3rem;"></i>
                        <h3 class="mt-4" data-i18n="index.appointment.booking.modal.success_title">Rendez-vous confirmé !</h3>
                        <p class="mb-2" data-i18n="index.appointment.booking.modal.success_body">Votre demande a été enregistrée avec succès.</p>
                        <p id="successDetails" class="mb-0 small text-muted"></p>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-primary rounded-pill" data-bs-dismiss="modal" data-i18n="index.appointment.booking.modal.close">Fermer</button>
                      </div>
                    </div>
                  </div>
                </div>
      
            </div>
          </div>
        <p class="fs-16" data-i18n="index.appointment.hero.contact_prompt"></p>
        <div class="text-center" dir="ltr">
          <strong>📞 <span class="dynamic-phone-text" id="appointment-phone-text">+212 708 156 603</span> </strong> | <a href="mailto:hello@digitoyou.me" class="text-warning">✉ hello@digitoyou.me</a>
        </div>
      </div>
    </div>
  </section>


  <!-- BENEFITS / PROCESS / METHOD / DELIVERY / FAQ (unchanged blocks from your previous version) -->
  <AboutSec />
  <FAQ />



  <!-- PAGE SCRIPTS (appointment-only) -->
    <Fragment slot="scripts">
  <script>
  // @ts-nocheck
      
          document.addEventListener('DOMContentLoaded', function () {
            var currentDate = new Date();
            var selectedDate = null;
            var selectedTimeSlot = null;
      
            function resetUIForNewSelection() {
              // Hide “selected slot” and Next button; clear grid + label
              var alertEl = document.querySelector('#selectedSlotDisplay .alert');
              if (alertEl) alertEl.classList.add('d-none');
      
              var nextBtn = document.getElementById('nextToContactInfo');
              if (nextBtn) nextBtn.style.display = 'none';
      
              var grid = document.getElementById('timeSlotsGrid');
              if (grid) grid.innerHTML = '';
      
              var label = document.getElementById('selectedDateTime');
              if (label) label.textContent = ''; // i18n will fill default if needed
            }
      
            function generateCalendar() {
              var calendar = document.getElementById('appointmentCalendar');
              var currentMonth = currentDate.getMonth();
              var currentYear = currentDate.getFullYear();
      
              // Any re-render (month change) should reset selection state
              selectedDate = null;
              selectedTimeSlot = null;
              resetUIForNewSelection();
      
              var header = document.createElement('div');
              header.className = 'calendar-header d-flex justify-content-between align-items-center mb-3';
              header.innerHTML =
                '<button class="btn btn-sm btn-outline-primary" style="background:none;color:yellow;" onclick="previousMonth()"><i class="uil uil-angle-left"></i></button>' +
                '<h5 class="mb-0">'+ new Date(currentYear, currentMonth).toLocaleDateString('fr-FR', { month:'long', year:'numeric' }) +'</h5>' +
                '<button class="btn btn-sm btn-outline-primary" style="background:none;color:yellow;" onclick="nextMonth()"><i class="uil uil-angle-right"></i></button>';
      
              calendar.innerHTML = '';
              calendar.appendChild(header);
      
              var grid = document.createElement('div');
                grid.className = 'calendar-grid';
                

      
              // Clearer weekday headers (Lundi..Dimanche)
              ['L','Ma','Me','J','V','S','D'].forEach(function(d){
                var el = document.createElement('div');
                el.className = 'calendar-day-header';
                el.textContent = d;
                grid.appendChild(el);
              });
      
              var firstDay = new Date(currentYear, currentMonth, 1);
              var lastDay  = new Date(currentYear, currentMonth + 1, 0);
              // Monday-first calendar: turn Sunday(0) into 7
              var startDay = firstDay.getDay() || 7;
      
              for (var i=0; i<startDay-1; i++) grid.appendChild(document.createElement('div'));
      
              for (var day=1; day<=lastDay.getDate(); day++){
                var dayEl = document.createElement('div');
                dayEl.className = 'calendar-day';
                dayEl.textContent = String(day);
      
                var dateToCheck = new Date(currentYear, currentMonth, day);
                var today = new Date(); today.setHours(0,0,0,0);
      
                if (dateToCheck >= today) {
                  dayEl.classList.add('available');
                  dayEl.addEventListener('click', function(e){
                    var number = parseInt(e.currentTarget.textContent, 10);
                    var picked = new Date(currentYear, currentMonth, number);
                    selectDate(picked, e.currentTarget);
                  });
                } else {
                  dayEl.classList.add('disabled');
                }
                grid.appendChild(dayEl);
              }
      
              calendar.appendChild(grid);
            }
      
            function generateTimeSlots(date) {
              var timeSlotsGrid = document.getElementById('timeSlotsGrid');
              timeSlotsGrid.innerHTML = '';
              ['09:00','10:00','11:00','14:00','15:00','16:00','17:00'].forEach(function(time){
                var slot = document.createElement('button');
                slot.type = 'button';
                slot.className = 'btn btn-sm rounded-pill px-3 time-slot-btn btn-outline-primary';
                slot.textContent = time;
                slot.addEventListener('click', function(e){ selectTimeSlot(time, e.currentTarget); });
                timeSlotsGrid.appendChild(slot);
              });
            }
      
            function selectDate(date, el) {
            selectedDate = date;

            // reset previous time selection
            selectedTimeSlot = null;
            document.querySelectorAll('#timeSlotsGrid .time-slot-btn').forEach(function(btn){
                btn.classList.remove('selected','btn-primary','active','muted');
                btn.classList.add('btn-outline-primary');
            });

            // hide alert + next until time picked
            const alertEl = document.querySelector('#selectedSlotDisplay .alert');
            if (alertEl) alertEl.classList.add('d-none');
            const nextBtn = document.getElementById('nextToContactInfo');
            if (nextBtn) nextBtn.style.display = 'none';

            // select day
            document.querySelectorAll('#appointmentCalendar .calendar-day').forEach(d => d.classList.remove('selected'));
            el.classList.add('selected');

            // rebuild slots for this date, then ensure none are muted yet
            generateTimeSlots(date);
            document.querySelectorAll('#timeSlotsGrid .time-slot-btn').forEach(btn => btn.classList.remove('muted'));
            }

            document.querySelectorAll('#timeSlotsGrid .time-slot-btn').forEach(btn => btn.classList.remove('muted'));

            function selectTimeSlot(time, el) {
                selectedTimeSlot = time;

                var all = document.querySelectorAll('#timeSlotsGrid .time-slot-btn');
                all.forEach(function(btn){
                    // reset
                    btn.classList.remove('selected','btn-primary','active','muted');
                    if (!btn.classList.contains('btn-outline-primary')) btn.classList.add('btn-outline-primary');
                    btn.setAttribute('aria-pressed', 'false');
                });

                if (el) {
                    // make chosen one active
                    el.classList.add('selected','btn-primary','active');
                    el.classList.remove('btn-outline-primary');
                    el.setAttribute('aria-pressed', 'true');
                }

                // mute the rest (still clickable)
                all.forEach(function(btn){
                    if (btn !== el) btn.classList.add('muted');
                });

                updateSelectedSlotDisplay();
                }

      
            function updateSelectedSlotDisplay() {
              var alertEl = document.querySelector('#selectedSlotDisplay .alert');
              if (!alertEl) return;
              if (selectedDate && selectedTimeSlot) {
                alertEl.classList.remove('d-none');
                var formatted = selectedDate.toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long', year:'numeric' });
                document.getElementById('selectedDateTime').textContent = formatted + ' à ' + selectedTimeSlot;
                document.getElementById('appointment_date').value = formatted;
                document.getElementById('appointment_time').value = selectedTimeSlot;
                document.getElementById('nextToContactInfo').style.display = 'block';
              }
            }
      
            // Step nav
            document.getElementById('nextToContactInfo').addEventListener('click', function(){
              document.getElementById('stepProgress').style.width = '100%';
              document.getElementById('calendarStep').style.display = 'none';
              document.getElementById('contactStep').style.display = 'block';
            });
            document.getElementById('backToCalendar').addEventListener('click', function(){
              document.getElementById('stepProgress').style.width = '50%';
              document.getElementById('contactStep').style.display = 'none';
              document.getElementById('calendarStep').style.display = 'block';
            });
      
            // Submit → Slack webhook (unchanged)
            var form = document.getElementById('appointmentForm');
            var submitBtn = document.getElementById('submitButton');
            var submitBtnLabel = submitBtn ? submitBtn.innerHTML : '';
      
            form.addEventListener('submit', async function(e){
              e.preventDefault();
              if (!selectedDate || !selectedTimeSlot) { alert('Veuillez sélectionner une date et un créneau horaire'); return; }
      
              var payload = {
                text: "🎯 Nouveau rendez-vous !",
                blocks: [
                  { type:"header", text:{ type:"plain_text", text:"📅 Nouvelle demande de rendez-vous", emoji:true } },
                  { type:"section", fields:[
                    { type:"mrkdwn", text:"*Nom:*\n" + ((document.getElementById('name').value||'-')) },
                    { type:"mrkdwn", text:"*Email:*\n" + ((document.getElementById('email').value||'-')) }
                  ]},
                  { type:"section", fields:[
                    { type:"mrkdwn", text:"*Date:*\n" + ((document.getElementById('appointment_date').value||'-')) },
                    { type:"mrkdwn", text:"*Heure:*\n" + ((document.getElementById('appointment_time').value||'-')) }
                  ]},
                  { type:"section", fields:[
                    { type:"mrkdwn", text:"*Téléphone:*\n" + ((document.getElementById('phoneNumber').value||'-')) },
                    { type:"mrkdwn", text:"*Mode de communication:*\n" + ((document.querySelector('input[name=\"communication\"]:checked')?.value||'-')) }
                  ]}
                ]
              };
              var message = (document.getElementById('message').value||'').trim();
              if (message) payload.blocks.push({ type:"section", text:{ type:"mrkdwn", text:"*Message:*\n" + message } });
      
              // Resolve API base without hardcoding full domain:
              // window.APP_API_BASE can be defined earlier (e.g., in layout via an env var), otherwise default '/api'
              var url = 'https://preprod.digitoyou.com/api/slack-webhook';

              try {
                if (submitBtn) {
                  (submitBtn /** @type {any} */).disabled = true;
                  submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Envoi…';
                }
                var res = await fetch(url, { method:'POST', headers:{ 'Content-Type':'application/json' }, body:JSON.stringify(payload) });
                var data = await res.json().catch(function(){ return {}; });
                if (!res.ok || data.success === false) throw new Error(data.error || ('Statut ' + res.status));
      
                var modalEl = document.getElementById('successModal');
                if (modalEl && modalEl.parentElement !== document.body) document.body.appendChild(modalEl);
      
                var b = window['bootstrap'];
                if (!b || !b.Modal) throw new Error('Bootstrap non chargé');
      
                var successModal = b.Modal.getOrCreateInstance(modalEl, { backdrop:true, keyboard:true });
                successModal.show();
      
                var onHidden = function(){
                  if (form) (form /** @type {HTMLFormElement} */).reset();
                  selectedDate = null; selectedTimeSlot = null;
                  var sp = document.getElementById('stepProgress'); if (sp) sp.style.width = '50%';
                  var cs = document.getElementById('contactStep'); if (cs) cs.style.display = 'none';
                  var cal = document.getElementById('calendarStep'); if (cal) cal.style.display = 'block';
                  generateCalendar();
                  if (submitBtn) { (submitBtn /** @type {any} */).disabled = false; submitBtn.innerHTML = submitBtnLabel; }
                  if (modalEl) modalEl.removeEventListener('hidden.bs.modal', onHidden);
                };
                if (modalEl) modalEl.addEventListener('hidden.bs.modal', onHidden);
      
              } catch (err) {
                console.error('Submit error:', err);
                alert('Erreur lors de l’envoi. Réessayez plus tard.\n' + (err && err.message ? err.message : ''));
                if (submitBtn) { (submitBtn /** @type {any} */).disabled = false; submitBtn.innerHTML = submitBtnLabel; }
              }
            });
      
            // Initial render + month nav
            generateCalendar();
            (window /** @type {any} */).previousMonth = function(){ currentDate.setMonth(currentDate.getMonth()-1); generateCalendar(); };
            (window /** @type {any} */).nextMonth     = function(){ currentDate.setMonth(currentDate.getMonth()+1); generateCalendar(); };
          });
        </script>
      </Fragment>
</Base>
