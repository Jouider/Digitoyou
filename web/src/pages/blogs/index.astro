---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, type BlogPost } from '../../lib/supabaseClient';

// Fetch all published blog posts at build time (SSG)
const posts: BlogPost[] = await getPublishedPosts();

// Get popular posts (latest 3 posts)
const popularPosts: BlogPost[] = posts.slice(0, 3);

// Helper function to format date
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
}

// Helper function to format short date
function formatShortDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('fr-FR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  });
}
---

<Base title="Blog - Digitoyou">
  <!-- Hero Section -->
  <section class="wrapper bg-soft-primary">
    <div class="container pt-10 pb-10 pt-md-14 pb-md-10 text-center">
      <div class="row">
        <div class="col-md-7 col-lg-6 col-xl-5 mx-auto">
          <h1 class="display-1 mb-3 mt-17" data-i18n="index.blog.hero.h1">Notre Blog</h1>
          <p class="lead px-lg-5 px-xxl-8" data-i18n-html="index.blog.hero.lead">
            Découvrez nos articles sur le développement web, le digital et l'entrepreneuriat.
          </p>
          <a href="/contact" class="btn btn-primary btn-lg rounded-pill mt-4" data-i18n="index.blog.hero.cta_projects">Démarrer un projet</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Posts Section -->
  <section class="wrapper bg-light" id="next-section">
    <div class="container py-14 py-md-16">
      <div class="row gx-lg-8 gx-xl-12">
        <!-- Main Content -->
        <div class="col-lg-8">
          <div class="blog classic-view">
            {posts.length === 0 ? (
              <div class="text-center py-10">
                <p class="lead text-muted">Aucun article disponible pour le moment.</p>
              </div>
            ) : (
              posts.map((post) => (
                <article class="post">
                  <div class="card">
                    {post.cover_image && (
                      <figure class="card-img-top overlay overlay-1 hover-scale">
                        <a href={`/blogs/${post.slug}`}>
                          <img 
                            src={post.cover_image} 
                            alt={post.title}
                            width="960"
                            height="540"
                            loading="lazy"
                            decoding="async"
                            style="aspect-ratio: 16/9; object-fit: cover;"
                          />
                        </a>
                        <figcaption>
                          <h5 class="from-top mb-0">Lire plus</h5>
                        </figcaption>
                      </figure>
                    )}
                    <div class="card-body">
                      <div class="post-header">
                        <h2 class="post-title mt-1 mb-0">
                          <a class="link-dark" href={`/blogs/${post.slug}`}>
                            {post.title}
                          </a>
                        </h2>
                      </div>
                      <div class="post-content">
                        <p>{post.excerpt}</p>
                      </div>
                    </div>
                    <div class="card-footer">
                      <ul class="post-meta d-flex mb-0">
                        <li class="post-date">
                          <i class="uil uil-calendar-alt"></i>
                          <span>{formatDate(post.published_at)}</span>
                        </li>
                        <li class="post-author">
                          <a href="#">
                            <i class="uil uil-user"></i>
                            <span>Par Digitoyou</span>
                          </a>
                        </li>
                      </ul>
                    </div>
                  </div>
                </article>
              ))
            )}
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="col-lg-4 sidebar mt-8 mt-lg-6">
          <div class="widget">
            <h4 class="widget-title mb-3">À propos</h4>
            <p>
              Digitoyou crée des sites web puissants, 100% personnalisés, 
              conçus pour convertir. Suivez notre blog pour des conseils 
              et actualités du web.
            </p>
          </div>

          {popularPosts.length > 0 && (
            <div class="widget">
              <h4 class="widget-title mb-3">Articles populaires</h4>
              <ul class="image-list">
                {popularPosts.map((post) => (
                  <li>
                    {post.cover_image && (
                      <figure class="rounded">
                        <a href={`/blogs/${post.slug}`}>
                          <img 
                            src={post.cover_image} 
                            alt={post.title}
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      </figure>
                    )}
                    <div class="post-content">
                      <h6 class="mb-2">
                        <a class="link-dark" href={`/blogs/${post.slug}`}>
                          {post.title}
                        </a>
                      </h6>
                      <ul class="post-meta">
                        <li class="post-date">
                          <i class="uil uil-calendar-alt"></i>
                          <span>{formatShortDate(post.published_at)}</span>
                        </li>
                      </ul>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="widget">
            <h4 class="widget-title mb-3">Besoin d'un site ?</h4>
            <a href="/contact" class="btn btn-primary rounded-pill">
              Contactez-nous
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .post {
    margin-bottom: 2rem;
  }
  
  .post-title a:hover {
    color: var(--bs-primary);
  }
  
  .widget {
    background: #fff;
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 0.25rem 1rem rgba(0, 0, 0, 0.05);
  }
</style>
